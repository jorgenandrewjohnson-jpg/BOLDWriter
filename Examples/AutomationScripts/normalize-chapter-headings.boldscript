{
  "format": "bold-script",
  "version": 1,
  "title": "Normalize chapter headings",
  "target": { "scope": "document" },
  "operations": [
    {
      "type": "normalizeHeadings",
      "rules": [
        { "paragraphPrefix": "Chapter ", "style": "Heading 1" },
        { "paragraphPrefix": "Section ", "style": "Heading 2" }
      ]
    }
  ]
}
